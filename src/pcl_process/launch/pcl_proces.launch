<launch>
  <!-- 雷达处理节点 (对应 rosrun pcl_process rslidar_process_node) -->
  <node pkg="pcl_process" type="rslidar_process_node" name="rslidar_process_node" output="screen"/>

  <!-- 圆柱拟合节点 (对应 rosrun pcl_process cylinder_fitting_node_ros) -->
  <node pkg="pcl_process" type="cylinder_fitting_node_ros" name="cylinder_fitting_node" output="screen"/>
</launch>