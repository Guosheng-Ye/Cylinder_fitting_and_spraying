<launch>
  <!-- 雷达处理节点 (对应 rosrun pcl_process rslidar_process_node_ros) -->
  <node pkg="pcl_process" type="rslidar_process_node_ros" name="rslidar_process_node" output="screen"/>

  <!-- 工字钢检测节点 (使用PCL Viewer本地可视化) -->
  <node pkg="pcl_process" type="ibeam_fitting_node_ros" name="ibeam_fitting_node" output="screen">
    <!-- 输入话题: 使用±45度过滤的点云 -->
    <param name="input_topic" value="/rslidar_filtered_ibeam"/>

    <!-- 从YAML配置文件加载所有检测参数 -->
    <!-- 修改参数只需编辑 config/ibeam_detection_params.yaml，无需重新编译 -->
    <rosparam file="$(find pcl_process)/config/ibeam_detection_params.yaml" command="load"/>
  </node>
</launch>
